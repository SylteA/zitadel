NEXT_PUBLIC_BASE_PATH=/ui/v2/login
# BRE Digital branding: background image for the login page, served from public/.
# The path must include the base path above, because public/ assets are served
# under it. Set at build time so the value is available to the client bundle.
# The background is a PNG at a stable path so a deployment can replace it by
# mounting another PNG over /app/apps/login/public/background.png without a
# rebuild. PNG only: the extension determines the Content-Type the file is
# served with, so other formats mounted at this path are not supported.
NEXT_PUBLIC_THEME_BACKGROUND_IMAGE=/ui/v2/login/background.png
# Frosted-glass card and buttons over the background image (built-in appearance).
# Like all NEXT_PUBLIC_* values this is baked into the bundle at build time.
NEXT_PUBLIC_THEME_APPEARANCE=glass
# Application name sent with invite codes, where it defaults to "Zitadel Login".
# Baked in at build time like the other NEXT_PUBLIC_* values.
NEXT_PUBLIC_APPLICATION_NAME=BRE Cloud
EMAIL_VERIFICATION=false
ZITADEL_API_URL=http://localhost:8080
ZITADEL_SERVICE_USER_TOKEN_FILE=../../login-client.pat

# Whether ui_locales from OAuth requests should always override the language cookie.
# When set to "true", the language from ui_locales will always be used.
# When unset or set to "false", ui_locales only sets the language if no cookie exists (preserves user's manual selection).
# ZITADEL_UI_LOCALES_OVERRIDE_COOKIE=false
